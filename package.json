{
  "name": "agentic-literature-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter @litagent/server --filter @litagent/web dev",
    "dev:server": "bun run --filter @litagent/server dev",
    "dev:web": "bun run --filter @litagent/web dev",
    "dev:desktop": "bun run --filter @litagent/desktop dev",
    "prepare:marker-runtime": "bun scripts/prepare-marker-runtime.ts",
    "build": "bun run --workspaces --if-present build",
    "typecheck": "bunx tsc -b",
    "test": "bunx vitest run",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "playwright": "^1.60.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
